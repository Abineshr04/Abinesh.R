import java.util.Scanner;
class calculator
{ 
      public static void main(String[]args)
       {
		Scanner scn=new Scanner(System.in);
		System.out.println("Enter x number");
		int x=scn.nextInt();
		System.out.println("Enter y number");
		int y=scn.nextInt();
		System.out.println("1 add/n 2. sub /n 3. mul /n 4. div /n 5. mod /n");
         int num =scn.nextInt();
        switch(num)
		{
case 1: System.out.println("result="+ (x+y));
break;

case 2:System.out.println("result="+(x-y));
break;

case 3:System.out.println("result="+(x*y));
break;

case 4:System.out.println("result="+(x/y));
break;

case 5:System.out.println("result="+(x%y));
break;

default:System.out.println("invalid choice");
}
	   
	   }
	   
}
